# Copy to .env and fill in. Never commit .env. Every key except DATABASE_URL is optional:
# the pipeline skips whatever isn't configured and still runs the rest.
# Step-by-step: docs/01-getting-started.md

# ---- Pipeline ---------------------------------------------------------------
# Supabase > Project settings > Database > Connection string (use the "Session pooler" URI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unslog
# Where the dashboard lives (used for links in the morning digest)
APP_URL=http://localhost:5173

# AI, free tiers. Gemini first, Groq as fallback. Without either, Unslog uses free heuristic
# scores and template drafts.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_SCORE_MODEL=gemini-3.5-flash-lite
GEMINI_DRAFT_MODEL=gemini-3.8-flash
GEMINI_DAILY_LIMIT=200
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Job sources
# https://jooble.org/api/about
JOOBLE_API_KEY=
# Gmail: create a "Desktop app" OAuth client, then run `npm run gmail:auth` to get the refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Morning digest by Telegram: create a bot with @BotFather, put your chat id in Settings
TELEGRAM_BOT_TOKEN=

# Only run for these Supabase user ids (comma-separated). Recommended once the dashboard is public.
ALLOWED_USER_IDS=

# Per-user cap on AI scoring calls against the shared Gemini/Groq key above (doesn't apply to
# users who add their own key in Settings). Keeps one signed-up user from spending the whole
# day's shared quota alone.
SHARED_AI_MAX_JOBS_PER_USER_PER_DAY=20

# ---- Web dashboard (read from this same root .env) ---------------------------
# Supabase > Project settings > API keys: the project URL and the anon (or "publishable") key.
# Safe in the browser: RLS protects the data. Never use the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
